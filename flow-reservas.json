{
  "version": "7.3",
  "data_api_version": "3.0",
  "routing_model": {
    "APPOINTMENT": [
      "DETAILS",
      "CANCELAR"
    ],
    "DETAILS": [
      "SUMMARY"
    ],
    "SUMMARY": [
      "SUCCESS"
    ],
    "SUCCESS": [],
    "CANCELAR": [
      "CONFIRMAR_CANCELACION"
    ],
    "CONFIRMAR_CANCELACION": [
      "SUCCESS"
    ]
  },
  "screens": [
    {
      "id": "APPOINTMENT",
      "title": "Reserva de cita",
      "data": {
        "profesionales": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "1",
              "title": "Profesional 1"
            }
          ]
        },
        "servicios": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "1",
              "title": "Servicio 1"
            }
          ]
        },
        "habilitar_servicios": {
          "type": "boolean",
          "__example__": false
        },
        "habilitar_fecha": {
          "type": "boolean",
          "__example__": false
        },
        "fecha_minima": {
          "type": "string",
          "__example__": "2026-11-16"
        },
        "fecha_maxima": {
          "type": "string",
          "__example__": "2026-12-16"
        },
        "fechas_no_disponibles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "__example__": []
        },
        "horarios": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "09:00",
              "title": "9:00 a. m."
            }
          ]
        },
        "habilitar_horarios": {
          "type": "boolean",
          "__example__": false
        },
        "aviso": {
          "type": "string",
          "__example__": "Selecciona una profesional y un servicio."
        },
        "telefono_remitente": {
          "type": "string",
          "__example__": "573001112233"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Agendar cita"
          },
          {
            "type": "TextBody",
            "text": "Números detectado: ${data.telefono_remitente}. ¿Qué deseas hacer?"
          },
          {
            "type": "Form",
            "name": "reserva",
            "children": [
              {
                "type": "Dropdown",
                "label": "¿Qué deseas hacer?",
                "name": "objetivo",
                "data-source": [
                  {
                    "id": "profesional",
                    "title": "Agendar cita"
                  },
                  {
                    "id": "cancelar",
                    "title": "Cancelar cita"
                  }
                ],
                "required": true,
                "on-select-action": {
                  "name": "data_exchange",
                  "payload": {
                    "accion": "${form.objetivo}",
                    "telefono": "${data.telefono_remitente}"
                  }
                }
              },
              {
                "type": "Dropdown",
                "label": "Profesional",
                "name": "profesional",
                "data-source": "${data.profesionales}",
                "required": true,
                "on-select-action": {
                  "name": "data_exchange",
                  "payload": {
                    "accion": "profesional",
                    "profesional": "${form.profesional}"
                  }
                }
              },
              {
                "type": "Dropdown",
                "label": "Servicio",
                "name": "servicio",
                "data-source": "${data.servicios}",
                "enabled": "${data.habilitar_servicios}",
                "required": "${data.habilitar_servicios}",
                "on-select-action": {
                  "name": "data_exchange",
                  "payload": {
                    "accion": "servicio",
                    "profesional": "${form.profesional}",
                    "servicio": "${form.servicio}"
                  }
                }
              },
              {
                "type": "CalendarPicker",
                "name": "fecha",
                "label": "Selecciona la fecha",
                "mode": "single",
                "required": "${data.habilitar_fecha}",
                "enabled": "${data.habilitar_fecha}",
                "min-date": "${data.fecha_minima}",
                "max-date": "${data.fecha_maxima}",
                "unavailable-dates": "${data.fechas_no_disponibles}",
                "on-select-action": {
                  "name": "data_exchange",
                  "payload": {
                    "accion": "fecha",
                    "profesional": "${form.profesional}",
                    "servicio": "${form.servicio}",
                    "fecha": "${form.fecha}"
                  }
                }
              },
              {
                "type": "Dropdown",
                "label": "Hora disponible",
                "name": "hora",
                "data-source": "${data.horarios}",
                "enabled": "${data.habilitar_horarios}",
                "required": "${data.habilitar_horarios}"
              },
              {
                "type": "TextBody",
                "text": "${data.aviso}"
              },
              {
                "type": "Footer",
                "label": "Continuar",
                "on-click-action": {
                  "name": "navigate",
                  "next": {
                    "type": "screen",
                    "name": "DETAILS"
                  },
                  "payload": {
                    "profesional": "${form.profesional}",
                    "servicio": "${form.servicio}",
                    "fecha": "${form.fecha}",
                    "hora": "${form.hora}",
                    "telefono_remitente": "${data.telefono_remitente}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "DETAILS",
      "title": "Tus datos",
      "data": {
        "profesional": {
          "type": "string",
          "__example__": "1"
        },
        "servicio": {
          "type": "string",
          "__example__": "1"
        },
        "fecha": {
          "type": "string",
          "__example__": "2026-11-16"
        },
        "hora": {
          "type": "string",
          "__example__": "09:00"
        },
        "telefono_remitente": {
          "type": "string",
          "__example__": "573001112233"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Tus datos"
          },
          {
            "type": "TextBody",
            "text": "Detectamos tu número de WhatsApp: ${data.telefono_remitente}. Confírmalo escribiéndolo o indica otro número de contacto."
          },
          {
            "type": "Form",
            "name": "datos",
            "children": [
              {
                "type": "TextInput",
                "name": "nombre",
                "label": "Nombre completo",
                "required": true
              },
              {
                "type": "TextInput",
                "name": "telefono",
                "label": "Teléfono de contacto",
                "input-type": "phone",
                "required": true
              },
              {
                "type": "Footer",
                "label": "Revisar reserva",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "accion": "revisar",
                    "profesional": "${data.profesional}",
                    "servicio": "${data.servicio}",
                    "fecha": "${data.fecha}",
                    "hora": "${data.hora}",
                    "nombre": "${form.nombre}",
                    "telefono": "${form.telefono}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "SUMMARY",
      "title": "Confirmar reserva",
      "data": {
        "resumen": {
          "type": "string",
          "__example__": "Profesional 1 · Servicio 1 · 16/11/2026, 9:00 a. m."
        },
        "profesional": {
          "type": "string",
          "__example__": "1"
        },
        "servicio": {
          "type": "string",
          "__example__": "1"
        },
        "fecha": {
          "type": "string",
          "__example__": "2026-11-16"
        },
        "hora": {
          "type": "string",
          "__example__": "09:00"
        },
        "nombre": {
          "type": "string",
          "__example__": "Cliente de prueba"
        },
        "telefono": {
          "type": "string",
          "__example__": "573001112233"
        },
        "telefono_remitente": {
          "type": "string",
          "__example__": "573001112233"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Comprueba tu cita"
          },
          {
            "type": "TextBody",
            "text": "${data.resumen}"
          },
          {
            "type": "TextBody",
            "text": "Contacto: ${data.telefono}"
          },
          {
            "type": "Form",
            "name": "confirmar",
            "children": [
              {
                "type": "Footer",
                "label": "Confirmar cita",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "accion": "confirmar",
                    "profesional": "${data.profesional}",
                    "servicio": "${data.servicio}",
                    "fecha": "${data.fecha}",
                    "hora": "${data.hora}",
                    "nombre": "${data.nombre}",
                    "telefono": "${data.telefono}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "SUCCESS",
      "title": "Operación confirmada",
      "terminal": true,
      "data": {
        "mensaje": {
          "type": "string",
          "__example__": "Tu cita está confirmada. ¡Te esperamos!"
        },
        "remitente": {
          "type": "string",
          "__example__": "573001112233"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "¡Listo!"
          },
          {
            "type": "TextBody",
            "text": "${data.mensaje}"
          },
          {
            "type": "Footer",
            "label": "Finalizar",
            "on-click-action": {
              "name": "complete",
              "payload": {
                "mensaje": "${data.mensaje}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "CANCELAR",
      "title": "Cancelar cita",
      "data": {
        "citas": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "1",
              "title": "16/11/2026, 9:00 a. m. — Servicio 1"
            }
          ]
        },
        "aviso": {
          "type": "string",
          "__example__": "Selecciona la cita que deseas cancelar."
        },
        "telefono_remitente": {
          "type": "string",
          "__example__": "573001112233"
        },
        "accion": {
          "type": "string",
          "__example__": "cancelar"
        },
        "telefono": {
          "type": "string",
          "__example__": "573001112233"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Cancelar cita"
          },
          {
            "type": "TextBody",
            "text": "Tus próximas citas asociadas a tu número de WhatsApp."
          },
          {
            "type": "Form",
            "name": "cancelacion",
            "children": [
              {
                "type": "TextInput",
                "name": "telefono",
                "label": "Teléfono de contacto (si reservaste con otro)",
                "input-type": "phone",
                "required": true
              },
              {
                "type": "Dropdown",
                "label": "Cita a cancelar",
                "name": "cita",
                "data-source": "${data.citas}",
                "required": true
              },
              {
                "type": "TextBody",
                "text": "${data.aviso}"
              },
              {
                "type": "Footer",
                "label": "Continuar",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "accion": "cancelar_seleccion",
                    "cita": "${form.cita}",
                    "telefono": "${form.telefono}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "CONFIRMAR_CANCELACION",
      "title": "Confirmar cancelación",
      "data": {
        "cita": {
          "type": "string",
          "__example__": "1"
        },
        "resumen": {
          "type": "string",
          "__example__": "16/11/2026, 9:00 a. m. — Servicio 1"
        },
        "aviso": {
          "type": "string",
          "__example__": "Confirma la cancelación. Esta acción libera el horario."
        },
        "telefono": {
          "type": "string",
          "__example__": "573001112233"
        },
        "accion": {
          "type": "string",
          "__example__": "cancelar_confirmar"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Confirmar cancelación"
          },
          {
            "type": "TextBody",
            "text": "${data.resumen}"
          },
          {
            "type": "TextBody",
            "text": "${data.aviso}"
          },
          {
            "type": "TextBody",
            "text": "Usa Atrás para volver al menú principal sin cancelar."
          },
          {
            "type": "Form",
            "name": "confirmar_cancelacion",
            "children": [
              {
                "type": "Footer",
                "label": "Confirmar cancelación",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "accion": "cancelar_confirmar",
                    "cita": "${data.cita}",
                    "telefono": "${data.telefono}"
                  }
                }
              }
            ]
          }
        ]
      }
    }
  ]
}